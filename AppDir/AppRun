#!/bin/bash
HERE="$(dirname "$(readlink -f "${0}")")"

# Allow symlinking to run different scripts

if [ ! -z $APPIMAGE ] ; then
    MAIN=$(basename "$ARGV0")
else
    MAIN=$(basename "$0")
fi

export PATH="${HERE}"/usr/bin/:"${HERE}"/bin/:"${PATH}"
export PYTHONHOME="$HERE/usr/"

export TCL_LIBRARY="$HERE/usr/share/tcltk/tcl8.6"

export LD_LIBRARY_PATH="${HERE}"/usr/lib/:"${HERE}"/usr/lib/x86_64-linux-gnu/:"${HERE}"/lib/:"${HERE}"/lib/x86_64-linux-gnu/:"${LD_LIBRARY_PATH}"

if [ -d "${HERE}/fonts" ] ; then
    export SKETCH_FONTPATH="${HERE}/fonts"
    export GS_LIB="$SKETCH_FONTPATH":"$GS_LIB"
fi

case $MAIN in
    sk-*)
	tryexec="${MAIN:3}"
	which "$tryexec" >& /dev/null && exec "$tryexec" "$@"
	;;
esac

# The launcher (src/skencil) expects build/scripts-<X.Y>/<tool> next to
# build/lib.linux-<arch>-<X.Y>/; derive <X.Y> from the bundled
# interpreter so this follows the build tree layout.
PYTHON="${HERE}"/usr/bin/python3.10
PYVER=$("$PYTHON" -c 'import sys; print("%d.%d" % sys.version_info[:2])')

if [ ! -e "${HERE}/build/scripts-${PYVER}/$MAIN" ] ; then
    MAIN=skencil
fi

exec "$PYTHON" "${HERE}/build/scripts-${PYVER}/$MAIN" "$@"
