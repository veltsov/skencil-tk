#!/bin/bash
# Development packages for the python3 build environment (Ubuntu 22.04
# jammy; python3 is 3.10 there, matching build/lib.linux-x86_64-3.10).
apt-get -y update
DEBIAN_FRONTEND=noninteractive apt-get install -y \
	locales build-essential git wget rsync \
	python3 python3-dev python3-tk python3-pil python3-pil.imagetk \
	    tcl-dev tk-dev \
	python3-pytest \
    pstoedit x11-utils x11-xserver-utils xvfb ghostscript

locale-gen en_US.UTF-8 en_GB.UTF-8 fi_FI.UTF-8

echo -e "LANG=en_US.UTF-8\nLC_NUMERIC=C\nLC_TIME=en_GB.UTF-8" > /etc/default/locale

rm -rf /var/cache/apt /var/lib/apt/lists
