#!/usr/bin/python
# Install one or more .sk files as test fixtures and regenerate their
# baseline (golden) artifacts.
#
# Usage: test/add-fixture FILE.sk [FILE2.sk ...]
#
# For each file:
#   1. the .sk file is copied to test/data/
#   2. every external file referenced by eps()/bm() directives is
#      copied along (symlinks resolved)
#   3. the basename is appended to test/data/fixtures.txt
#   4. baseline artifacts (saved .sk, EPS, raster) are regenerated
#      against the baseline build (master worktree if present, else the
#      repository build with a warning)
#
# Afterwards `git add' the new files under test/.

from __future__ import print_function

import os
import subprocess
import sys

TEST_DIR = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, TEST_DIR)

import collect_refs
import testsupport


def main():
    if len(sys.argv) < 2:
        print('usage: test/add-fixture FILE.sk [FILE2.sk ...]',
              file=sys.stderr)
        return 2
    for src in sys.argv[1:]:
        if not os.path.exists(src):
            print('no such file: %s' % src, file=sys.stderr)
            return 1
        name = os.path.basename(src)
        copied = collect_refs.copy_with_refs(src, testsupport.DATA_DIR)
        print('installed %s (%d files)' % (name, len(copied)))
        with open(testsupport.MANIFEST) as f:
            known = set(line.strip() for line in f
                        if line.strip() and not line.startswith('#'))
        if name not in known:
            with open(testsupport.MANIFEST, 'a') as f:
                f.write(name + '\n')
        subprocess.check_call([sys.executable,
                               os.path.join(TEST_DIR, 'record.py'), name])
    return 0


if __name__ == '__main__':
    sys.exit(main())
